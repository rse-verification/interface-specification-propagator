(alias (name "isp_032_array_index_processing.c")
  (deps (alias "isp_032_array_index_processing.0.exec"))) ; to reproduce and visualize the all sub-test outputs related to a file
(rule ; TEST #0 OF TEST FILE tests/general/isp_032_array_index_processing.c
  (alias "isp_032_array_index_processing.0.exec.wtests")
  (targets "isp_032_array_index_processing.0.err.log" "isp_032_array_index_processing.0.res.log"  )
  (deps "isp_032_array_index_processing.0.exec.wtests" "../oracle/isp_032_array_index_processing.0.res.oracle" "../oracle/isp_032_array_index_processing.0.err.oracle"  "isp_032_array_index_processing.c"  (package frama-c)  (package "frama-c-isp") )
  (enabled_if (and true %{lib-available:frama-c-isp.core}))
(action (run frama-c-wtests -brief "isp_032_array_index_processing.0.exec.wtests" "frama-c -check -no-autoload-plugins -load-plugin=isp    isp_032_array_index_processing.c -no-check -autoload-plugins -isp -isp-print > \"isp_032_array_index_processing.0.res.log\" 2> \"isp_032_array_index_processing.0.err.log\"" ))
)
(rule ; REPRODUCE TEST #0 OF TEST FILE "isp_032_array_index_processing.c"
  (alias "isp_032_array_index_processing.0.exec")
  (deps  "isp_032_array_index_processing.c"  (package frama-c)  (package "frama-c-isp")  (universe))
  (enabled_if (and true %{lib-available:frama-c-isp.core}))
(action (with-accepted-exit-codes 0 (system "frama-c -check -no-autoload-plugins -load-plugin=isp    isp_032_array_index_processing.c -no-check -autoload-plugins -isp -isp-print")))
)
(rule ; SHOW TEST COMMAND #0 OF TEST FILE "isp_032_array_index_processing.c"
  (alias "isp_032_array_index_processing.0.exec.show")
  (deps  "isp_032_array_index_processing.c"  (package frama-c)  (package "frama-c-isp")  (universe))
  (enabled_if (and true %{lib-available:frama-c-isp.core}))
(action (system "echo 'frama-c -check -no-autoload-plugins -load-plugin=isp    isp_032_array_index_processing.c -no-check -autoload-plugins -isp -isp-print > \"isp_032_array_index_processing.0.res.log\" 2> \"isp_032_array_index_processing.0.err.log\"'"))
)
(rule
  (alias "isp_032_array_index_processing.0.exec.diff")
  (enabled_if (and true %{lib-available:frama-c-isp.core}))
(action (diff "../oracle/isp_032_array_index_processing.0.res.oracle" "isp_032_array_index_processing.0.res.log"))
)
(rule
  (alias "isp_032_array_index_processing.0.exec.diff")
  (enabled_if (and true %{lib-available:frama-c-isp.core}))
(action (diff "../oracle/isp_032_array_index_processing.0.err.oracle" "isp_032_array_index_processing.0.err.log"))
)
(alias (name "isp_032_array_index_processing.diff")
  (deps (alias "isp_032_array_index_processing.0.exec.diff"))
  (enabled_if (and true %{lib-available:frama-c-isp.core}))
)
(alias (name "runtest_config")
  (deps (alias "isp_032_array_index_processing.diff"))
  (enabled_if (and true %{lib-available:frama-c-isp.core}))
)
(alias (name disabled_runtest)
  (deps (alias disabled_runtest_config)))
(alias (name runtest)
  (deps (alias disabled_runtest)))
(alias (name runtest_config)
  (deps (alias disabled_runtest_config)))
(rule ; Warns when some test conditions are disabled
  (alias disabled_runtest_config)
  (deps (universe))
  (enabled_if (or false  (not %{lib-available:frama-c-isp.core})))
  (action (progn (echo "WARNING: Enabling conditions of some tests are false for @tests/general/runtest_config\n")
                 (echo "- \%{lib-available:frama-c-isp.core}: " %{lib-available:frama-c-isp.core} "\n")
  ))
)

